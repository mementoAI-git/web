# API
VITE_API_BASE_URL=http://localhost:5000

# PostHog
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=your_posthog_host

# ── Gemini Model Versions ──
# Override the live/audio model used by the web client.
# Defaults are baked into the code — only set these if you need a different version.
VITE_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
