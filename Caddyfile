# Caddyfile for Memento Frontend
# Serves static files from the dist folder (Vite build output)
# 
# Usage:
#   1. Build the React app: yarn build
#   2. Run Caddy: caddy run
#   3. Access at http://localhost:3000

# Global options
{
	# Enable automatic HTTPS (Let's Encrypt)
	auto_https on
	
	# Email for Let's Encrypt certificate notifications
	# Replace with your email address
	email info@mymemento.io
	
	# Logging
	log {
		output stdout
		format console
	}
}

# Production: Frontend domain
dev.mymemento.io {
	# Access logs
	log {
		format console
	}

	# Serve static files from the 'dist' folder (Vite build output)
	# Make sure to run 'yarn build' first to generate the dist folder
	root * /var/www/dev.mymemento.io

	# Enable gzip compression for better performance
	encode gzip

	# Serve static files
	file_server

	# Handle client-side routing (SPA fallback)
	# If file doesn't exist, serve index.html for React Router
	# This is essential for React Router to work properly
	try_files {path} /index.html

	# Security headers
	header {
		# Security headers
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Cache static assets (optional, uncomment if needed)
		# Cache-Control "public, max-age=31536000, immutable"
	}

	# Optional: Custom error pages
	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /index.html
	}
}

# Development: Local testing (uncomment if needed)
